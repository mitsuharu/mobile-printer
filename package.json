    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-swag-styles": "^0.2.2",
    "react-native-uuid": "^2.0.2",
    "react-native-vector-icons": "^10.1.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
